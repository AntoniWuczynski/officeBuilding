#!/bin/sh
# Block a commit that adds secrets or private details (scripts/check-sensitive.ts).
# This repo's hooksPath overrides any global one, so also run the machine-wide
# guard (gitleaks and friends) when this machine has it.
guard="$HOME/.claude/git-hooks/public_repo_guard.py"
if [ -f "$guard" ]; then python3 "$guard" pre-commit || exit 1; fi
exec node --no-warnings scripts/check-sensitive.ts --staged
